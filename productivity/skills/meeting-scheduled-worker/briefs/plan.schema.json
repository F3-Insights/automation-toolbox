{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting plan",
  "description": "What the analyst returns for one recording. meeting-validate checks the quotes against the transcript and the ids; meeting-publish writes it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recording_id", "digest", "note_title", "note_content", "summary_evidence", "actions",
               "clarifications", "enrichment_refs", "flags"],
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment", "quote"],
        "properties": {
          "segment": {"type": "integer", "minimum": 0},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "id": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"}
  },
  "properties": {
    "recording_id": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "note_title": {"type": "string", "minLength": 1},
    "note_content": {"type": "string", "minLength": 1},
    "summary_evidence": {"$ref": "#/$defs/evidence"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "owner_contact_id", "domain_id", "project_id", "existing_task_id",
                     "due_date", "disposition", "evidence"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "description": {"type": "string"},
          "owner_contact_id": {"$ref": "#/$defs/id"},
          "domain_id": {"$ref": "#/$defs/id"},
          "project_id": {"$ref": "#/$defs/id"},
          "existing_task_id": {"$ref": "#/$defs/id"},
          "due_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "disposition": {"enum": ["create", "link_existing", "proposal", "unresolved"]},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "options": {"type": "array", "items": {"type": "string"}},
          "recommended": {"type": "string"}
        }
      }
    },
    "enrichment_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^portal://(contact|company)/[0-9a-fA-F-]{36}$"}
    },
    "flags": {"type": "array", "items": {"type": "string"}}
  }
}
