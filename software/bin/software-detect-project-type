#!/bin/sh
# Generated by scripts/build_bins.py; do not edit.
# Runs skills/software-portfolio-review/scripts/detect_project_type.sh from this plugin, wherever the plugin is and however this file is linked.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
root="$(cd "$(dirname "$self")/.." && pwd -P)"
exec bash "$root/skills/software-portfolio-review/scripts/detect_project_type.sh" "$@"
