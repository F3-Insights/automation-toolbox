#!/bin/sh
# Generated by scripts/build_bins.py; do not edit.
# Runs skills/calendar-steward-method/scripts/calendar_steward_check.py from this plugin, wherever the plugin is and however this file is linked.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
root="$(cd "$(dirname "$self")/.." && pwd -P)"
exec python3 "$root/skills/calendar-steward-method/scripts/calendar_steward_check.py" "$@"
